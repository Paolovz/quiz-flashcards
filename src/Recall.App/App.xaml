<Application x:Class="Recall.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recall.ViewModels"
             xmlns:views="clr-namespace:Recall.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette first: Tokens and Controls resolve its brushes on load. -->
                <ResourceDictionary Source="Themes/Palette/Clay.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
                <views:LibraryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DeckViewModel}">
                <views:DeckView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StudyViewModel}">
                <views:StudyView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:QuizViewModel}">
                <views:QuizView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SummaryViewModel}">
                <views:SummaryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ImportViewModel}">
                <views:ImportView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
