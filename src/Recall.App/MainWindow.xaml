<Window x:Class="Recall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:Recall.Controls"
        Title="Recall"
        Height="780" Width="1200"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Wash}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}"
                BorderThickness="0,0,0,1" Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource BtnGhost}" Command="{Binding HomeCommand}"
                        Padding="8,6" AutomationProperties.Name="Go to deck library">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="10"
                                Background="{DynamicResource B.Primary}" VerticalAlignment="Center">
                            <TextBlock Text="R" Foreground="{DynamicResource B.OnPrimary}" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource F.Display}" />
                        </Border>
                        <TextBlock Text="Recall" Style="{StaticResource T.H2}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource B.WarnSoft}"
                            Margin="0,0,8,0" ToolTip="Consecutive days with at least one review">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Streak" Style="{StaticResource T.Label}"
                                       Foreground="{DynamicResource B.Warn}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StreakText}" Style="{StaticResource T.Label}"
                                       Foreground="{DynamicResource B.Warn}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Chip}" ToolTip="Cards due across every deck">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Due" Style="{StaticResource T.Label}"
                                       Foreground="{DynamicResource B.PrimaryDeep}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DueText}" Style="{StaticResource T.Label}"
                                       Foreground="{DynamicResource B.PrimaryDeep}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource BtnGhost}" Command="{Binding SettingsCommand}"
                            Margin="6,0,0,0" Padding="10,8"
                            ToolTip="Appearance and data"
                            AutomationProperties.Name="Open settings">
                        <!-- Sliders, drawn rather than font-dependent. -->
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="20" Height="20">
                                <Path Data="M0,5 H20 M0,10 H20 M0,15 H20"
                                      Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.8" />
                                <Ellipse Canvas.Left="11" Canvas.Top="2" Width="6" Height="6"
                                         Fill="{DynamicResource B.Surface}"
                                         Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.8" />
                                <Ellipse Canvas.Left="4" Canvas.Top="7" Width="6" Height="6"
                                         Fill="{DynamicResource B.Surface}"
                                         Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.8" />
                                <Ellipse Canvas.Left="13" Canvas.Top="12" Width="6" Height="6"
                                         Fill="{DynamicResource B.Surface}"
                                         Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.8" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <cc:RevealHost Grid.Row="1" Content="{Binding Current}" Margin="28,24,28,0" />
    </Grid>
</Window>
