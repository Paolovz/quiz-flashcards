<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Typography ============
         One display face, one text face, six sizes. Weight carries hierarchy before
         size does, so nothing has to shout. -->

    <Style x:Key="T.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="23" />
    </Style>

    <Style x:Key="T.Small" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    </Style>

    <!-- ============ Surfaces ============
         A panel is a hairline and one step of value. No drop shadow on anything that
         sits in the page flow: shadows belong to things that float over it. -->

    <Style x:Key="Clay" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Lg}" />
    </Style>

    <Style x:Key="ClayFlat" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Lg}" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.SurfaceAlt}" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Sm}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ Buttons ============
         Hover and press are a tint over the fill, not a scale. A control that grows
         under the cursor is a web habit; a desktop button steps in value. -->

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Background" Value="{DynamicResource B.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource R.Md}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- State wash. Sits under the content, never moves it. -->
                            <Border x:Name="Wash" CornerRadius="{StaticResource R.Md}"
                                    Background="{DynamicResource B.Text}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Setters, not storyboards: trigger precedence resolves hover and
                             press on its own, and every state reverts when it stops matching. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.13" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Ring}" />
                        </Trigger>
                        <!-- A disabled control fades, unless it carries Tag="graded". Graded
                             rows are read-only by design and their tick and letter have to
                             stay legible, so the row keeps full contrast. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False" />
                                <Condition Property="Tag" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource B.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource B.OnPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource B.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource B.OnPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="BtnGrade" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="14,13" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <!-- ============ Inputs ============ -->

    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.PrimarySoft}" />
        <Setter Property="Background" Value="{DynamicResource B.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="{StaticResource R.Md}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Ring}" />
                        </Trigger>
                        <!-- Tag="invalid" is the error state, and it outranks hover and focus. -->
                        <Trigger Property="Tag" Value="invalid">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Danger}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.DangerSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputMulti" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ============ Lists ============ -->

    <Style x:Key="Row" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="{StaticResource R.Md}"
                            Background="{DynamicResource B.Surface}"
                            BorderBrush="{DynamicResource B.Border}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.PrimarySoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Progress ============ -->

    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource B.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3"
                                Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3"
                                Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Scrollbar ============ -->

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Margin="3,2"
                                                    Background="{DynamicResource B.BorderStrong}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />

    <!-- ============ Checkbox ============ -->

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Box" Grid.Column="0" Width="20" Height="20" CornerRadius="{StaticResource R.Sm}"
                                Background="{DynamicResource B.Background}"
                                BorderBrush="{DynamicResource B.BorderStrong}"
                                BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0">
                            <!-- Geometry is authored in its own 12x12 space and scaled to fit,
                                 so the tick never clips against the border. -->
                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M1,6.2 L4.4,9.6 L11,2.2"
                                      Stroke="{DynamicResource B.OnPrimary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Viewbox>
                        </Border>

                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource B.Primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource B.Primary}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource B.PrimaryDeep}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Combo box ============ -->

    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="{StaticResource R.Sm}" Padding="{TemplateBinding Padding}"
                            Background="Transparent" Margin="4,2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.PrimarySoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.PrimaryDeep}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="{StaticResource R.Md}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource B.BorderStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource B.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                              Stretch="None" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource B.Surface}" CornerRadius="{StaticResource R.Lg}"
                                    Margin="0,4,0,0" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                    Padding="2" MaxHeight="280" MinWidth="{Binding ActualWidth,
                                                RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <!-- The one place a shadow is correct: this floats. -->
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                                      Opacity="0.45" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
