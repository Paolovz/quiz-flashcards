<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Clay: study purple with a correct-answer green. The default. -->
    <Color x:Key="C.Primary">#7C3AED</Color>
    <Color x:Key="C.PrimaryDeep">#6D28D9</Color>
    <Color x:Key="C.PrimarySoft">#EDE9FE</Color>
    <Color x:Key="C.OnPrimary">#FFFFFF</Color>
    <Color x:Key="C.Accent">#059669</Color>
    <Color x:Key="C.AccentDeep">#047857</Color>
    <Color x:Key="C.AccentSoft">#D1FAE5</Color>
    <Color x:Key="C.Warn">#D97706</Color>
    <Color x:Key="C.WarnSoft">#FEF3C7</Color>
    <Color x:Key="C.Danger">#DC2626</Color>
    <Color x:Key="C.DangerSoft">#FEE2E2</Color>
    <Color x:Key="C.Background">#FAF5FF</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#F7F3FD</Color>
    <Color x:Key="C.Border">#EFE7FC</Color>
    <Color x:Key="C.BorderStrong">#DDD0F5</Color>
    <Color x:Key="C.Text">#0F172A</Color>
    <Color x:Key="C.TextMuted">#475569</Color>
    <Color x:Key="C.TextFaint">#64748B</Color>
    <Color x:Key="C.Heat1">#DDD6FE</Color>
    <Color x:Key="C.Heat2">#A78BFA</Color>
    <Color x:Key="C.Scrim">#8A4C1D95</Color>

    <SolidColorBrush x:Key="B.Primary" Color="{StaticResource C.Primary}" />
    <SolidColorBrush x:Key="B.PrimaryDeep" Color="{StaticResource C.PrimaryDeep}" />
    <SolidColorBrush x:Key="B.PrimarySoft" Color="{StaticResource C.PrimarySoft}" />
    <SolidColorBrush x:Key="B.OnPrimary" Color="{StaticResource C.OnPrimary}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentDeep" Color="{StaticResource C.AccentDeep}" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="{StaticResource C.AccentSoft}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="B.WarnSoft" Color="{StaticResource C.WarnSoft}" />
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="{StaticResource C.DangerSoft}" />
    <SolidColorBrush x:Key="B.Background" Color="{StaticResource C.Background}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.TextMuted" Color="{StaticResource C.TextMuted}" />
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}" />
    <SolidColorBrush x:Key="B.Heat1" Color="{StaticResource C.Heat1}" />
    <SolidColorBrush x:Key="B.Heat2" Color="{StaticResource C.Heat2}" />
    <SolidColorBrush x:Key="B.Scrim" Color="{StaticResource C.Scrim}" />
    <SolidColorBrush x:Key="B.Ring" Color="{StaticResource C.Primary}" />
    <SolidColorBrush x:Key="B.White70" Color="#FFFFFF" Opacity="0.72" />

    <LinearGradientBrush x:Key="B.Wash" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#F7F1FE" Offset="0" />
        <GradientStop Color="#FBF7FF" Offset="0.45" />
        <GradientStop Color="#F3F6FF" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="E.Card" Color="#4C1D95" BlurRadius="26" ShadowDepth="6"
                      Direction="270" Opacity="0.10" />
    <DropShadowEffect x:Key="E.CardSoft" Color="#4C1D95" BlurRadius="16" ShadowDepth="3"
                      Direction="270" Opacity="0.07" />
    <DropShadowEffect x:Key="E.Primary" Color="#5B21B6" BlurRadius="18" ShadowDepth="5"
                      Direction="270" Opacity="0.26" />
</ResourceDictionary>
