<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Everything that does not change with the palette. Colors and brushes live in
         Themes/Palette/*.xaml and are swapped at runtime by Theming/ThemeManager. -->

    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Text">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- One radius scale. Four steps, no exceptions: a control is not rounder because
         it is bigger. Overlays get the last step, nothing else does. -->
    <CornerRadius x:Key="R.Sm">4</CornerRadius>
    <CornerRadius x:Key="R.Md">6</CornerRadius>
    <CornerRadius x:Key="R.Lg">8</CornerRadius>
    <CornerRadius x:Key="R.Xl">12</CornerRadius>

    <!-- Hairlines. A surface is separated by a 1px line and a step in value, never by
         weight. Thick borders read as a toy. -->
    <Thickness x:Key="W.Hair">1</Thickness>

    <!-- Motion tokens. Short distances, ease-out, exit faster than enter. -->
    <Duration x:Key="D.Fast">0:0:0.11</Duration>
    <Duration x:Key="D.Base">0:0:0.18</Duration>
    <Duration x:Key="D.Slow">0:0:0.26</Duration>

    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />
    <CubicEase x:Key="Ease.InOut" EasingMode="EaseInOut" />

    <BooleanToVisibilityConverter x:Key="BoolVis" />

</ResourceDictionary>
