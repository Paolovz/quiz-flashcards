<UserControl x:Class="Recall.Views.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recall.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:QuizViewModel}"
             mc:Ignorable="d"
             Focusable="True">

    <UserControl.Resources>
        <!-- One row of a choice question. The whole row is the hit target, so a click
             anywhere on the option counts — not just on the letter or the tick. -->
        <Style x:Key="Option" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
            <Setter Property="Background" Value="{DynamicResource B.SurfaceAlt}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource B.BorderStrong}" />
                </Trigger>

                <!-- Multi-select keeps its picked rows lit until the answer is checked. -->
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.PrimarySoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource B.Primary}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding State}" Value="correct">
                    <Setter Property="Tag" Value="graded" />
                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource B.AccentDeep}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="wrong">
                    <Setter Property="Tag" Value="graded" />
                    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource B.Danger}" />
                    <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="missed">
                    <Setter Property="Tag" Value="graded" />
                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource B.AccentDeep}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The letter chip on a single-answer row. -->
        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource B.PrimarySoft}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,12,0" />
        </Style>

        <Style x:Key="ChoicePanel" TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypedPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTyped}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MultiPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMultiSelect}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrderPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOrder}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MatchPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImagePanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasImage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FeedbackPanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Answered}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWrongAnswer}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource B.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Once the answer is in, the submit control has nothing left to do. -->
        <Style x:Key="SubmitButton" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Answered}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Session bar -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Chip}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource T.Label}"
                               Foreground="{DynamicResource B.PrimaryDeep}" />
                </Border>
                <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Background="{DynamicResource B.AccentSoft}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Score" Style="{StaticResource T.Label}"
                                   Foreground="{DynamicResource B.AccentDeep}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScoreText}" Style="{StaticResource T.Label}"
                                   Foreground="{DynamicResource B.AccentDeep}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Style="{StaticResource BtnGhost}" Content="End quiz" HorizontalAlignment="Right"
                    Command="{Binding ExitCommand}" AutomationProperties.Name="End this quiz" />
        </Grid>

        <ProgressBar Grid.Row="1" Style="{StaticResource Bar}" Maximum="100"
                     Value="{Binding Progress, Mode=OneWay}" Height="8" />

        <!-- Question -->
        <Border Grid.Row="2" Style="{StaticResource Clay}" Margin="0,18,0,0" Padding="32,26">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Center">
                <StackPanel MaxWidth="760">

                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Padding="12,5">
                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource T.Label}"
                                   Foreground="{DynamicResource B.PrimaryDeep}" />
                    </Border>

                    <TextBlock Text="{Binding Prompt}" Style="{StaticResource T.Display}" FontSize="27"
                               LineHeight="38" Margin="0,14,0,0" />

                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource T.Small}" FontStyle="Italic"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasSource, Converter={StaticResource BoolVis}}" />

                    <Border Style="{StaticResource ImagePanel}" Margin="0,18,0,0" CornerRadius="16"
                            BorderBrush="{DynamicResource B.Border}" BorderThickness="2" Padding="10"
                            HorizontalAlignment="Left">
                        <Image Source="{Binding ImagePath}" MaxHeight="240" Stretch="Uniform"
                               AutomationProperties.Name="Question image" />
                    </Border>

                    <!-- Single answer: Q&A, multiple choice, image, true or false -->
                    <ItemsControl Style="{StaticResource ChoicePanel}" ItemsSource="{Binding Options}" Margin="0,24,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Option}"
                                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Text}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource KeyChip}">
                                            <TextBlock Text="{Binding Key}" FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource B.PrimaryDeep}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" LineHeight="23" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Typed answer: Q&A, image, fill the blanks -->
                    <StackPanel Style="{StaticResource TypedPanel}" Margin="0,24,0,0">
                        <TextBox Style="{StaticResource Input}" Text="{Binding TypedInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="17" Padding="18,14" AutomationProperties.Name="Type the answer" />
                        <Button Style="{StaticResource SubmitButton}" Content="Submit answer"
                                Command="{Binding SubmitCommand}" />
                    </StackPanel>

                    <!-- Multi-select: one or more rows, then check -->
                    <StackPanel Style="{StaticResource MultiPanel}" Margin="0,24,0,0">
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Option}"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Text}">
                                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=OneWay}"
                                                  IsHitTestVisible="False" Focusable="False">
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource T.Body}"
                                                       VerticalAlignment="Center" />
                                        </CheckBox>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource SubmitButton}" Content="Check answer"
                                Command="{Binding SubmitMultiCommand}" />
                    </StackPanel>

                    <!-- Order -->
                    <StackPanel Style="{StaticResource OrderPanel}" Margin="0,24,0,0">
                        <ListBox ItemsSource="{Binding OrderItems}" Background="Transparent" BorderThickness="0"
                                 Padding="0" ItemContainerStyle="{StaticResource Row}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Items to order">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Text}" Style="{StaticResource T.Body}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource Btn}" Content="Up" Padding="12,7"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="Move up" />
                                            <Button Style="{StaticResource Btn}" Content="Down" Padding="12,7"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="Move down" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Style="{StaticResource SubmitButton}" Content="Check answer"
                                Command="{Binding SubmitOrderCommand}" />
                    </StackPanel>

                    <!-- Match -->
                    <StackPanel Style="{StaticResource MatchPanel}" Margin="0,24,0,0">
                        <ItemsControl ItemsSource="{Binding MatchRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Left}" Style="{StaticResource T.Body}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <ComboBox Grid.Column="1" Style="{StaticResource Combo}"
                                                  ItemsSource="{Binding Rights}"
                                                  SelectedItem="{Binding SelectedRight, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Left}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource SubmitButton}" Content="Check answer"
                                Command="{Binding SubmitMatchCommand}" />
                    </StackPanel>

                    <!-- Feedback -->
                    <Border Style="{StaticResource FeedbackPanel}" Margin="0,22,0,0" Padding="18,16"
                            CornerRadius="16" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="{Binding FeedbackTitle}" Style="{StaticResource T.H2}" />
                            <TextBlock Text="{Binding FeedbackDetail}" Style="{StaticResource T.Body}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Next -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Enter to continue" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Notice}" Style="{StaticResource T.Small}" Margin="14,0,0,0"
                           Foreground="{DynamicResource B.Danger}" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasNotice, Converter={StaticResource BoolVis}}" />
            </StackPanel>

            <Button Style="{StaticResource BtnPrimary}" Content="Next question" HorizontalAlignment="Right"
                    Command="{Binding NextCommand}" MinWidth="190" HorizontalContentAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
