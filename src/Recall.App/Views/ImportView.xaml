<UserControl x:Class="Recall.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recall.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ImportViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Clay}" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Import a PDF" Style="{StaticResource T.H1}" />
                    <TextBlock Style="{StaticResource T.Small}" Margin="0,6,0,0" MaxWidth="560"
                               HorizontalAlignment="Left"
                               Text="Recall reads the text layer and pulls out definition sentences and cloze cards. Every card is quoted from the document, so you can check each one before it lands in a deck." />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="190">
                    <TextBlock Text="CARD TYPE" Style="{StaticResource T.Label}" Margin="2,0,0,6" />
                    <ComboBox Style="{StaticResource Combo}" Height="38"
                              ItemsSource="{Binding KindOptions}"
                              SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                              ToolTip="{Binding KindHelp}"
                              AutomationProperties.Name="Card type for imported cards">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="MAX CARDS" Style="{StaticResource T.Label}" Margin="2,0,0,6" />
                            <TextBox Style="{StaticResource Input}" Width="90"
                                     Text="{Binding MaxCardsText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Maximum number of cards" />
                        </StackPanel>
                        <Button Style="{StaticResource BtnPrimary}" Content="Choose PDF"
                                Command="{Binding ChooseFileCommand}" VerticalAlignment="Bottom"
                                MinWidth="130" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <Grid Grid.Row="1" Margin="2,14,2,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding FileName}" Style="{StaticResource T.Body}" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding PageLabel}" Style="{StaticResource T.Label}"
                               Foreground="{DynamicResource B.PrimaryDeep}" />
                </Border>
            </StackPanel>

            <Button Style="{StaticResource BtnGhost}" Content="Cancel" HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource T.Small}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,90,0" MaxWidth="360"
                   TextTrimming="CharacterEllipsis" />

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource ClayFlat}" Margin="0,12,0,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding SelectionLabel}" Style="{StaticResource T.Label}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnGhost}" Content="Select all"
                                Command="{Binding SelectAllCommand}" />
                        <Button Style="{StaticResource BtnGhost}" Content="Select none"
                                Command="{Binding SelectNoneCommand}" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Drafts}" Background="Transparent"
                         BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource Row}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}"
                         AutomationProperties.Name="Extracted cards">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{StaticResource Check}"
                                          IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,2,14,0"
                                          AutomationProperties.Name="Include this card" />

                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <TextBlock Text="{Binding Front}" Style="{StaticResource T.Body}"
                                                   FontWeight="SemiBold" Margin="0,0,90,0" />
                                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Kind}" Style="{StaticResource T.Label}"
                                                       Foreground="{DynamicResource B.PrimaryDeep}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Back}" Style="{StaticResource T.Small}" Margin="0,5,0,0" />

                                    <TextBlock Text="{Binding Source}" Style="{StaticResource T.Small}"
                                               Foreground="{DynamicResource B.TextFaint}" FontStyle="Italic"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty / idle / busy -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoResult, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Nothing loaded yet" Style="{StaticResource T.H2}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource T.Small}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               MaxWidth="420" TextAlignment="Center"
                               Text="Pick a PDF with a real text layer — scanned images need OCR first. Then review the extracted cards and add the ones you want." />
                    <Button Style="{StaticResource BtnPrimary}" Content="Choose PDF" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Command="{Binding ChooseFileCommand}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource T.Small}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" MaxWidth="420"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource T.Small}" VerticalAlignment="Center"
                       Text="Checked cards become a new deck. Nothing is written until you press Add." />
            <Button Style="{StaticResource BtnAccent}" HorizontalAlignment="Right" MinWidth="200"
                    HorizontalContentAlignment="Center" Command="{Binding AddCommand}"
                    Content="Add selected cards" AutomationProperties.Name="Add the selected cards to a new deck" />
        </Grid>
    </Grid>
</UserControl>
