<UserControl x:Class="Recall.Views.DeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recall.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DeckViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Compact pill used for the card-kind picker. -->
        <Style x:Key="Pill" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="{StaticResource R.Sm}" Padding="12,7"
                                Background="{DynamicResource B.SurfaceAlt}"
                                BorderBrush="{DynamicResource B.Border}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Primary}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.OnPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource B.OnPrimary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>

        <!-- Star / suspend toggles: fill in when the flag is on, so the state reads at a glance. -->
        <Style x:Key="StarBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStarred}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource B.AccentDeep}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuspendBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.WarnSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource B.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Deck header -->
        <Border Grid.Row="0" Style="{StaticResource Clay}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource BtnGhost}" Command="{Binding BackCommand}"
                        Content="Back" VerticalAlignment="Top" Margin="0,2,12,0"
                        AutomationProperties.Name="Back to deck library" />

                <StackPanel Grid.Column="1">
                    <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                             FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource F.Display}"
                             Background="Transparent" BorderThickness="0" Padding="0,0,0,2"
                             AutomationProperties.Name="Deck name" />

                    <TextBox Style="{StaticResource Input}" Text="{Binding Subject, UpdateSourceTrigger=LostFocus}"
                             FontSize="13" Foreground="{DynamicResource B.TextMuted}"
                             Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0"
                             AutomationProperties.Name="Deck subject" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding CountLabel}" Style="{StaticResource T.Small}" />
                        <TextBlock Text="·" Style="{StaticResource T.Small}" Margin="8,0" />
                        <TextBlock Text="{Binding DueLabel}" Style="{StaticResource T.Small}"
                                   Foreground="{DynamicResource B.PrimaryDeep}" />
                        <TextBlock Text="·" Style="{StaticResource T.Small}" Margin="8,0" />
                        <TextBlock Text="{Binding MasteryText}" Style="{StaticResource T.Small}"
                                   Foreground="{DynamicResource B.AccentDeep}" />
                        <TextBlock Text="mastery" Style="{StaticResource T.Small}" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding StudyCommand}" Content="Study"
                                MinWidth="88" HorizontalContentAlignment="Center" />
                        <Button Style="{StaticResource Btn}" Command="{Binding QuizCommand}" Content="Quiz"
                                MinWidth="88" Margin="8,0,0,0" HorizontalContentAlignment="Center"
                                IsEnabled="{Binding CanQuiz}"
                                AutomationProperties.Name="Quiz this deck" />
                        <Button Style="{StaticResource Btn}" Command="{Binding CramCommand}" Content="Cram"
                                Margin="8,0,0,0" ToolTip="Run every card, ignoring the schedule" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource BtnGhost}" Command="{Binding StudyStarredCommand}"
                                Content="{Binding StarredLabel}" ToolTip="Study only the cards you starred" />
                        <Button Style="{StaticResource BtnGhost}" Command="{Binding ImportPdfCommand}"
                                Content="Import PDF" Margin="4,0,0,0" />
                        <Button Style="{StaticResource BtnGhost}" Command="{Binding ImportCsvCommand}"
                                Content="Import CSV" Margin="4,0,0,0"
                                ToolTip="Add rows from a CSV, TSV or Quizlet export" />
                        <Button Style="{StaticResource BtnGhost}" Command="{Binding ExportCommand}"
                                Content="Export" Margin="4,0,0,0"
                                ToolTip="Write the deck out as CSV for Anki, Quizlet or Excel" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cards + editor -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="*" MinWidth="290" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ClayFlat}" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="SEARCH" Style="{StaticResource T.Label}" Margin="2,0,0,6" />
                        <Grid Grid.Row="1">
                            <TextBox Style="{StaticResource Input}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,8" Margin="0,0,96,0"
                                     AutomationProperties.Name="Search cards" />
                            <Button Style="{StaticResource Btn}" Content="Add card"
                                    HorizontalAlignment="Right" Command="{Binding AddCommand}" />
                        </Grid>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Cards}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource Row}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Cards in this deck">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource T.Label}"
                                                       Foreground="{DynamicResource B.PrimaryDeep}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Front}" Style="{StaticResource T.Body}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="44" />
                                        <TextBlock Text="{Binding Back}" Style="{StaticResource T.Small}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="22" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="★" FontSize="13" HorizontalAlignment="Right" Margin="0,0,2,4"
                                                   Foreground="{DynamicResource B.Accent}"
                                                   ToolTip="Starred"
                                                   Visibility="{Binding Starred, Converter={StaticResource BoolVis}}" />

                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding StatusLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
                                                        <Setter Property="Foreground" Value="{DynamicResource B.PrimaryDeep}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Suspended}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource B.Warn}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="This deck is empty" Style="{StaticResource T.H2}" HorizontalAlignment="Center" />
                        <TextBlock Text="Add a card on the right, or import a PDF." Style="{StaticResource T.Small}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoMatches, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="No cards match that search" Style="{StaticResource T.Body}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Style="{StaticResource Clay}" Padding="22,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource T.H1}" />

                        <TextBlock Text="CARD TYPE" Style="{StaticResource FieldLabel}" />
                        <ListBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource Pill}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Card type">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource PillText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding KindHelp}" Style="{StaticResource T.Small}" Margin="2,2,0,0" />

                        <TextBlock Text="{Binding FrontLabel}" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputMulti}" Text="{Binding Front, UpdateSourceTrigger=PropertyChanged}"
                                 Height="86" AutomationProperties.Name="Card question" />

                        <!-- Q&A / image / fill-the-blanks answer -->
                        <StackPanel Visibility="{Binding HasBackField, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding BackLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMulti}" Text="{Binding Back, UpdateSourceTrigger=PropertyChanged}"
                                     Height="86" AutomationProperties.Name="Card answer" />
                        </StackPanel>

                        <!-- Image picker -->
                        <StackPanel Visibility="{Binding IsImage, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="IMAGE" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <TextBox Style="{StaticResource Input}" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,9" Margin="0,0,96,0" AutomationProperties.Name="Image file path" />
                                <Button Style="{StaticResource Btn}" Content="Browse" HorizontalAlignment="Right"
                                        Command="{Binding BrowseImageCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Multiple choice and multi-select share the options box -->
                        <StackPanel Visibility="{Binding ShowsChoices, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="OPTIONS · one per line, * marks the correct one(s)"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMulti}" Text="{Binding ChoicesText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="112" AutomationProperties.Name="Multiple choice options" />
                        </StackPanel>

                        <!-- Order -->
                        <StackPanel Visibility="{Binding IsOrder, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="ITEMS · one per line, top to bottom is correct" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMulti}" Text="{Binding ItemsText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="112" AutomationProperties.Name="Ordered items" />
                        </StackPanel>

                        <!-- Match -->
                        <StackPanel Visibility="{Binding IsMatch, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="PAIRS · one per line as left = right" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMulti}" Text="{Binding PairsText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="112" AutomationProperties.Name="Matching pairs" />
                        </StackPanel>

                        <!-- True or false -->
                        <StackPanel Visibility="{Binding IsTrueFalse, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="ANSWER" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="True" IsChecked="{Binding AnswerIsTrue}" GroupName="TfAnswer"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="False" IsChecked="{Binding AnswerIsFalse}" GroupName="TfAnswer" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="HINT · optional" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Input}" Text="{Binding Hint, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Card hint" />

                        <TextBlock Text="TAGS · optional, space separated" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Input}" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Card tags" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource StarBtn}" Command="{Binding ToggleStarCommand}"
                                    Content="{Binding StarLabel}" IsEnabled="{Binding IsEditing}"
                                    ToolTip="Starred cards can be studied on their own" />
                            <Button Style="{StaticResource SuspendBtn}" Command="{Binding ToggleSuspendCommand}"
                                    Content="{Binding SuspendLabel}" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsEditing}"
                                    ToolTip="Suspended cards stay out of every session" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}"
                                    Content="Save card" MinWidth="120" HorizontalContentAlignment="Center" />
                            <Button Style="{StaticResource BtnDanger}" Command="{Binding DeleteCardCommand}"
                                    Content="{Binding DeleteLabel}" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsEditing}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource T.Small}"
                                   Foreground="{DynamicResource B.AccentDeep}" Margin="2,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
