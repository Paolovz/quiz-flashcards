<UserControl x:Class="Recall.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recall.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SummaryViewModel}"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,10,0,28">

            <Border Style="{StaticResource Clay}" Padding="34,30">
                <StackPanel>
                    <TextBlock Text="{Binding Kind}" Style="{StaticResource T.Label}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource T.Display}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Small}" HorizontalAlignment="Center"
                               Margin="0,6,0,0" />

                    <TextBlock Text="{Binding AccuracyLabel}" FontFamily="{StaticResource F.Display}" FontSize="64"
                               FontWeight="Bold" Foreground="{DynamicResource B.Primary}"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="accuracy" Style="{StaticResource T.Label}" HorizontalAlignment="Center" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ClayFlat}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="CORRECT" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding ScoreLabel}" Style="{StaticResource T.Metric}"
                                           FontSize="22" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ClayFlat}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TIME" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource T.Metric}"
                                           FontSize="22" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ClayFlat}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="MODE" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding Kind}" Style="{StaticResource T.Metric}"
                                           FontSize="22" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding Body}" Style="{StaticResource T.Body}"
                               Foreground="{DynamicResource B.TextMuted}" TextAlignment="Center"
                               Margin="0,22,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ClayFlat}" Padding="22,18" Margin="0,16,0,0"
                    Visibility="{Binding HasMissed, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="MISSED THIS ROUND" Style="{StaticResource T.Label}" />
                    <ItemsControl ItemsSource="{Binding Missed}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource B.DangerSoft}" CornerRadius="10"
                                        Padding="12,9" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Body}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" MaxHeight="42" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="These come back sooner in the schedule." Style="{StaticResource T.Small}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Style="{StaticResource BtnPrimary}" Content="Run it again" Command="{Binding AgainCommand}"
                        MinWidth="160" HorizontalContentAlignment="Center" />
                <Button Style="{StaticResource Btn}" Content="Back to deck" Command="{Binding BackCommand}"
                        Margin="10,0,0,0" MinWidth="150" HorizontalContentAlignment="Center" />
                <Button Style="{StaticResource BtnGhost}" Content="All decks" Command="{Binding LibraryCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
